#!/usr/bin/env python3
# perif-battery — unified battery reader for Keychron M6 (vendor HID) and
# Logitech MX Keys (via Solaar). Emits one JSON object on stdout.
#
# M6 protocol is reverse-engineered from the Keychron Ultra-Link 8K dongle
# (USB 3434:d028). Battery lives in the last byte of the 0xFFC1 vendor
# status report (report id 0xB3 out / 0xB6 in, cmd 0x05).
#
# The dongle only answers while the M6 radio link is up, so reads are
# opportunistic and last-known values are cached.

import errno
import fcntl
import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path

CACHE = Path.home() / ".cache" / "perif-battery" / "last.json"
CACHE.parent.mkdir(parents=True, exist_ok=True)

# --- M6 (Keychron Ultra-Link 8K) -------------------------------------------

M6_DESCRIPTOR_PREFIX = bytes([0x06, 0xC1, 0xFF])  # Usage Page (Vendor 0xFFC1)
REPORT_OUT = 0xB3      # 63-byte output report
REPORT_IN_STATUS = 0xB6  # 20-byte input status report (cmd 0x05)
REPORT_IN_BIG = 0xB4     # 63-byte input report (cmd 0x06)
STATUS_CMD = 0x05


def find_m6_hidraw():
    """Return the /dev/hidrawN for the 0xFFC1 interface, or None."""
    base = Path("/sys/class/hidraw")
    if not base.exists():
        return None
    for entry in sorted(base.iterdir(), key=lambda p: p.name):
        name = entry.name  # hidrawN
        if not name.startswith("hidraw"):
            continue
        uevent = entry / "device" / "uevent"
        if not uevent.exists():
            continue
        try:
            text = uevent.read_text()
        except OSError:
            continue
        # Must be the Keychron Ultra-Link 8K dongle
        if "Keychron Ultra-Link 8K" not in text:
            continue
        rd = entry / "device" / "report_descriptor"
        if not rd.exists():
            continue
        try:
            desc = rd.read_bytes()
        except OSError:
            continue
        # The 0xFFC1 interface descriptor starts with that prefix and has
        # report ids 0xB3..0xB6.
        if desc.startswith(M6_DESCRIPTOR_PREFIX):
            return f"/dev/{name}"
    return None


def _set_nonblock(fd):
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)


def _drain(fd):
    try:
        while True:
            os.read(fd, 1024)
    except BlockingIOError:
        pass
    except OSError:
        pass


def _query_m6_once(fd, timeout=0.4):
    """Send status query, return the 20-byte status payload or None."""
    _drain(fd)
    # report id byte + 63 data bytes (cmd 0x05 then zeros)
    out = bytes([REPORT_OUT, STATUS_CMD]) + b"\x00" * 62
    try:
        os.write(fd, out)
    except OSError:
        return None
    deadline = time.time() + timeout
    while time.time() < deadline:
        ready, _, _ = select.select([fd], [], [], 0.04)
        if not ready:
            continue
        try:
            data = os.read(fd, 256)
        except BlockingIOError:
            continue
        except OSError:
            return None
        if not data:
            continue
        rid = data[0]
        payload = data[1:]
        # We want the 20-byte status frame (rid 0xB6) echoing cmd 0x05.
        if rid == REPORT_IN_STATUS and len(payload) >= 20 and payload[0] == STATUS_CMD:
            return payload[:20]
        # The big frame (rid 0xB4) also starts with the same 20-byte block.
        if rid == REPORT_IN_BIG and len(payload) >= 20 and payload[0] == STATUS_CMD:
            return payload[:20]
    return None


def read_m6():
    """Return the current M6 state, including whether its dongle is present."""
    dev = find_m6_hidraw()
    if dev is None:
        return {
            "level": None,
            "connected": False,
            "stale": False,
            "error": "no-dongle",
            "ts": time.time(),
        }
    try:
        fd = os.open(dev, os.O_RDWR)
    except OSError as e:
        return {
            "level": None,
            "connected": False,
            "stale": False,
            "error": f"open:{e.errno}",
            "ts": time.time(),
        }
    _set_nonblock(fd)
    try:
        payload = None
        for _ in range(3):
            payload = _query_m6_once(fd, timeout=0.45)
            if payload is not None:
                break
    finally:
        os.close(fd)
    if payload is None:
        # The dongle is still visible, so this is a sleeping/unresponsive
        # mouse rather than a confirmed disconnection.  collect() may use the
        # last level while preserving that distinction for the UI.
        return {
            "level": None,
            "connected": True,
            "stale": True,
            "error": "asleep",
            "ts": time.time(),
        }
    # Battery percentage is the last byte of the status frame.
    level = payload[19]
    if not (0 <= level <= 100):
        level = None
    return {"level": level, "connected": True, "stale": False, "ts": time.time()}


# --- MX Keys (Logitech, via Solaar) ----------------------------------------

_BATT_RE = re.compile(r"Battery:\s*(\d+)%,?\s*BatteryStatus\.(\w+)")


def read_mxkeys():
    """Return the MX Keys state, including whether Solaar found its battery."""
    try:
        proc = subprocess.run(
            ["solaar", "show"],
            capture_output=True, text=True, timeout=20,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        return {
            "level": None,
            "connected": False,
            "charging": None,
            "status": None,
            "error": str(e),
            "ts": time.time(),
        }
    m = _BATT_RE.search(proc.stdout)
    if not m:
        return {
            "level": None,
            "connected": False,
            "charging": None,
            "status": None,
            "error": "no-battery-line",
            "ts": time.time(),
        }
    level = int(m.group(1))
    status = m.group(2).lower()  # discharging / charging / full / recharging...
    charging = status in ("charging", "full", "recharging")
    return {
        "level": level,
        "connected": True,
        "charging": charging,
        "status": status,
        "ts": time.time(),
    }


# --- Orchestration + cache -------------------------------------------------

# MX Keys battery barely changes, but presence must be refreshed promptly so a
# disconnected keyboard does not remain in the panel for several minutes.
# `solaar show` is the presence probe and can take a few seconds on a cold
# cache, so keep it to the panel refresh cadence rather than every read.
MXKEYS_TTL = 60  # seconds


def _load_cache():
    try:
        return json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return {}


def _save_cache(data):
    try:
        CACHE.write_text(json.dumps(data))
    except OSError:
        pass


def collect(fresh_mxkeys=True):
    cache = _load_cache()
    now = time.time()

    m6 = read_m6()
    # Keep last known M6 level when the mouse is asleep.
    if (
        m6.get("level") is None
        and m6.get("connected") is True
        and "m6" in cache
        and cache["m6"].get("level") is not None
    ):
        last = cache["m6"]
        m6 = {
            "level": last["level"],
            "connected": True,
            "stale": True,
            "ts": last.get("ts", now),
            "last_read": last.get("ts", now),
        }

    # Decide whether to re-query MX Keys (slow ~11s) or serve cache.
    cached_mxk = cache.get("mxkeys")
    mxk_age = now - cached_mxk.get("ts", 0) if cached_mxk and cached_mxk.get("ts") else None
    do_fresh_mx = fresh_mxkeys and (mxk_age is None or mxk_age > MXKEYS_TTL)

    if do_fresh_mx:
        mxk = read_mxkeys()
    else:
        # Serve cached value; mark staleness purely by age for the UI.
        mxk = dict(cached_mxk) if cached_mxk else {"level": None}
        if "connected" not in mxk:
            # Migrate cache entries written before presence tracking was
            # introduced.  A cached level is only displayed until the next
            # real Solaar probe can confirm presence.
            mxk["connected"] = mxk.get("level") is not None
        if mxk.get("ts"):
            mxk["stale"] = (now - mxk["ts"]) > MXKEYS_TTL
        else:
            mxk["stale"] = True

    result = {
        "m6": m6,
        "mxkeys": mxk,
        "now": now,
    }
    _save_cache(result)
    return result


def main():
    # Optional arg to skip the (slower) Solaar query for fast M6-only reads.
    fresh_mxkeys = "--mx-only" not in sys.argv
    data = collect(fresh_mxkeys=fresh_mxkeys)
    print(json.dumps(data))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # never crash the extension
        print(json.dumps({"error": str(e)}))
        sys.exit(0)
